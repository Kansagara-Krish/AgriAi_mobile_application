# AgriAI Backend Environment Configuration
PROJECT_NAME="AgriAI Diagnostic and Recommendation Backend"
API_V1_PREFIX="/api"
HOST="0.0.0.0"
PORT=8000

# Database Configuration (Defaults to SQLite in local_database/agriai.db)
DATABASE_URL="sqlite:///../local_database/agriai.db"

# Model Artifact Locations (Optional overrides, default points to trained_models/)
# CNN_SAVEDMODEL_DIR="trained_models/cnn/efficientnetb0_savedmodel"
# SOIL_MODEL_PATH="trained_models/soil/xgb_soil_health_best.joblib"
# FERT_MODEL_PATH="trained_models/fertilizer/xgb_fertilizer_recommendation_best.joblib"
# KB_CSV_PATH="trained_models/knowledge_base/fertilizer_knowledge_base.csv"

# CORS Configuration (Comma-separated origins or *)
CORS_ORIGINS="*"
